# Copy to .env. Do not commit real secrets.
# Primary local development database for the app, Prisma, and scripts.
# Automated tests must not use this URL. Leave an existing .env value unchanged.
DATABASE_URL=postgresql://mms:change-me@127.0.0.1:54329/mms_dev
# Isolated integration-test database. npm test and npm run test:unit read only this variable.
# The guard accepts 127.0.0.1 port 54329 database mms_test, and refuses every other target.
DATABASE_URL_TEST=postgresql://mms:change-me@127.0.0.1:54329/mms_test

# HS256 secret, at least 32 characters. Generate a unique value per environment.
AUTH_SECRET=replace-with-a-random-string-at-least-32-chars
AUTH_ISSUER=mms
AUTH_AUDIENCE=mms-web

# Optional. At least 32 characters. Leave empty to disable the database health check.
# Unauthenticated GET /api/health stays a generic process response.
# Authorized probes send: Authorization: Bearer <token>
HEALTH_CHECK_TOKEN=

BOOTSTRAP_ADMIN_EMAIL=bootstrap.admin@mms.local
# Leave empty to generate a one-time password into data/bootstrap-admin.local.txt
BOOTSTRAP_ADMIN_PASSWORD=

# Required only when running scripts/migrate/run.ts against the local database.
MMS_ALLOW_MIGRATION=local-dev
LEGACY_DUMP_PATH=./docs/db.txt

UPLOAD_DIR=./data/uploads
APP_URL=http://127.0.0.1:3000

# Optional. Comma-separated proxy addresses or CIDRs allowed to supply X-Forwarded-For.
# Unset means loopback only, matching `next start -H 127.0.0.1` behind deploy/nginx.example.conf.
# That proxy appends $remote_addr. It does not set X-Real-IP. An empty value trusts no proxy.
# TRUSTED_PROXIES=127.0.0.1,::1

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MMS <noreply@example.com>
